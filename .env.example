# MOVA Phone · plantilla de variables de entorno (Studio Lexair)
# Copia este archivo a .env SOLO en tu entorno local. Nunca subas .env al repositorio.
# En GitHub Actions se usan GitHub Secrets (ver .github/workflows/).

# --- GitHub (solo para scripts/automatización local) ---
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# --- Firma de release (rellenar solo en local o en GitHub Secrets) ---
# Ruta al keystore de release. En CI se genera desde el secreto RELEASE_KEYSTORE_BASE64.
MOVA_KEYSTORE_PATH=
MOVA_KEYSTORE_PASSWORD=
MOVA_KEY_ALIAS=
MOVA_KEY_PASSWORD=

# Nombres de los secretos recomendados en GitHub Actions:
# RELEASE_KEYSTORE_BASE64   (keystore .jks codificado en base64)
# RELEASE_KEYSTORE_PASSWORD
# RELEASE_KEY_ALIAS
# RELEASE_KEY_PASSWORD
