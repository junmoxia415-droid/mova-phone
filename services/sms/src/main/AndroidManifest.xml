<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <!-- Cuarta pieza que Android exige a la app de mensajes predeterminada:
         responder con un mensaje corto desde la pantalla de llamada. -->
    <uses-permission android:name="android.permission.SEND_RESPOND_VIA_MESSAGE" />

    <application>
        <receiver
            android:name=".MovaSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="900">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          MOVA Phone como aplicación de MENSAJES predeterminada.
          SMS_DELIVER y WAP_PUSH_DELIVER son los avisos que Android envía a la app de
          mensajes del sistema: con ellos MOVA recibe y guarda los SMS por su cuenta.
        -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Respuesta rápida desde la pantalla de llamada del sistema (rol de SMS). -->
        <service
            android:name=".MovaRespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Confirmación real del envío de SMS (uso interno de la app). -->
        <receiver
            android:name=".MovaSmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.studiolexair.movaphone.action.SMS_SENT" />
            </intent-filter>
        </receiver>

        <!-- Confirmación de entrega: segunda palomita de la conversación. -->
        <receiver
            android:name=".MovaSmsDeliveredReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.studiolexair.movaphone.action.SMS_DELIVERED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
