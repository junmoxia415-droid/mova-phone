<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacidad: los datos de MOVA Phone (contactos de emergencia, historial, eventos de seguridad)
  permanecen en el dispositivo. No se permite backup automático en la nube.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>
