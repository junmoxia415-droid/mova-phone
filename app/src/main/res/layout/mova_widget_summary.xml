<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Te han escrito»: resumen real de mensajes pendientes y llamadas perdidas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mova_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/mova_widget_accent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/widget_summary_title"
            android:textColor="#E6EDF7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mova_widget_pill_bg"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/widget_refresh"
            android:textColor="#C4B5FD"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/mova_widget_row_bg"
        android:padding="10dp"
        android:textColor="#E6EDF7"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_calls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/mova_widget_row_bg"
        android:padding="10dp"
        android:textColor="#E6EDF7"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_summary_hint"
        android:textColor="#94A3B8"
        android:textSize="11sp" />
</LinearLayout>
